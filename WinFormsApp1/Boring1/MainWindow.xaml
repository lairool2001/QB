<Window x:Class="Boring1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Boring1"
        xmlns:a="clr-namespace:Diga.WebView2.Wpf;assembly=Diga.WebView2.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <RichTextBox Margin="10,371,-10,10" Name="text" PreviewKeyDown="RichTextBox1_KeyDown">
            <FlowDocument>
                <Paragraph>
                    <Run Text="RichTextBox"/>
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
        <a:WebView x:Name="WebView1"
                   WebViewCreated="WebView1_WebViewCreated"
                   WebMessageReceived="WebView1_WebMessageReceived"
                   DefaultBackgroundColor="White"
                   Margin="10,10,10,77"
                   />
    </Grid>
</Window>
