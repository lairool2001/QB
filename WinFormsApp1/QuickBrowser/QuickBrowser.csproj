<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>QuickBrowser</RootNamespace>
    <AssemblyName>QuickBrowser</AssemblyName>
    <!-- d2dlib64 / libwebp-x64 / Everything64 / FFmpeg 都是 x64 原生 DLL -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>FileCardGlow (2).ico</ApplicationIcon>
    <!-- 沿用 Properties\AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- .resx 內有圖示等非字串資源，dotnet CLI 建置需要預先序列化 -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!--
      NU1701：MediaInfo.Wrapper 只有 .NET Framework 版本，純 P/Invoke 包裝，可在 .NET 8 執行
      CA1416：Windows 專用 API 的平台相容性提示（本程式只跑在 Windows）
      SYSLIB0014 等：舊 API 過時警告
    -->
    <NoWarn>$(NoWarn);NU1701;CA1416;SYSLIB0003;SYSLIB0006;SYSLIB0011;SYSLIB0014;SYSLIB0051;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
    <PackageReference Include="Leayal.WebPWrapper.WinForm" Version="1.0.5" />
    <PackageReference Include="LibVLCSharp" Version="3.9.4" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.4" />
    <PackageReference Include="MediaInfo.Native" Version="26.1.0" />
    <PackageReference Include="MediaInfo.Wrapper" Version="26.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="unvell.D2DLib-x64" Version="1.4.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本機編譯的函式庫（沿用原本的路徑） -->
    <Reference Include="EverythingSharp">
      <HintPath>D:\EverythingSharp-master\EverythingSharp\EverythingSharp\bin\Debug\EverythingSharp.dll</HintPath>
    </Reference>
    <Reference Include="IconExtractor">
      <HintPath>D:\IconExtractor-1.0\IconExtractor\bin\Debug\IconExtractor.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 隨程式一起輸出的原生檔案 -->
    <Content Include="d2dlib64.dll;Everything64.dll;libwebp-x64.dll;shell32.dll;ffprobe.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="FFmpeg\bin\x64\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- SmartThreadPool 資料夾內附的其他平台專案檔不參與建置 -->
    <None Remove="SmartThreadPool\*.csproj" />
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
